# نسخة من هذا الملف إلى .env على خادم الإنتاج ثم عدّل القيم.
APP_NAME=Edubba
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- MySQL (الإنتاج) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edubba
DB_USERNAME=edubba
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=your-domain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Notification channels ----
SMS_PROVIDER=twilio
SMS_FROM=EDUBBA
WHATSAPP_PROVIDER=meta
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
NOTIF_RATE_PER_SECOND=10
NOTIF_DAILY_CAP=5000

# ---- ZainCash (Iraq) ----
ZAINCASH_SANDBOX=false
ZAINCASH_MERCHANT_ID=
ZAINCASH_MERCHANT_SECRET=
ZAINCASH_MSISDN=
ZAINCASH_IQN=

# ---- Qi Card (Iraq) ----
QICARD_SANDBOX=false
QICARD_TERMINAL_ID=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_MERCHANT_KEY=

# ---- Backup ----
BACKUP_PATH=
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump
